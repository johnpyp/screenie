# act (`mise run ci`, `mise run ci:package`) runs the workflows' jobs locally, in
# catthehacker's images of GitHub's runners, quirks included. Jobs on arm64 runners are skipped.
-P ubuntu-24.04=ghcr.io/catthehacker/ubuntu:full-24.04
-P ubuntu-22.04=ghcr.io/catthehacker/ubuntu:full-22.04
--pull=false
--container-daemon-socket -
